set bg=dark
set number
syntax on
" set cursorline
set expandtab
set shiftwidth=4

set tabstop=4       " The width of a TAB is set to 4.
                    " Still it is a \t. It is just that
                    " Vim will interpret it to be having
                    " a width of 4.


colorscheme darcula
set termguicolors
